---
import Base from '../layouts/Base.astro';
import { copy } from '../../copy';
const c = copy.colophon;
---
<Base title={c.title} description={c.description}>
  <header class="page-head">
    <h1>{c.heading}</h1>
  </header>
  <article class="prose">
    <p>{c.stack}</p>
    <h2>{c.globeHeading}</h2>
    <p>{c.globeBefore}<a href="https://github.com/shuding/cobe">{c.globeCobe}</a>{c.globeMiddle}<a href="https://fabianschultz.com">{c.globeFabian}</a>{c.globeAfter}<a href="https://github.com/fabe/site">{c.globePublic}</a>{c.globeEnd}</p>
    <h2>{c.drumHeading}</h2>
    {c.drum.map((para) => <p>{para}</p>)}
  </article>
</Base>
