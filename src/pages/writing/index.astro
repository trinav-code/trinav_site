---
import { copy } from '../../../copy';
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { writingFeed } from '../../lib/feed';
import { site } from '../../../site.config';

const posts = await writingFeed();
const byYear = new Map<string, typeof posts>();
for (const p of posts) {
  const y = p.date ? String(p.date.getFullYear()) : copy.writing.draftsGroup;
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const external = posts.filter((p) => p.external).length;
---
<Base title={copy.writing.title} description={copy.writing.description}>
  <header class="page-head">
    <h1>{copy.writing.heading}</h1>
    <p>{copy.writing.intro}</p>
  </header>

  {[...byYear.entries()].map(([year, items]) => (
    <section class="block year">
      <div class="year-label" aria-hidden="true">{year}</div>
      <WritingList posts={items} />
    </section>
  ))}

  <p class="elsewhere">
    {external > 0 && <Fragment set:html={copy.writing.elsewhere(external, `<a href="${site.links.medium}" rel="me external">${copy.footer.medium}</a>`)} />}
    {external === 0 && copy.writing.elsewhereEmpty}
  </p>
</Base>
