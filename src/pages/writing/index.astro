---
import Base from '../../layouts/Base.astro';
import { writingFeed } from '../../lib/feed';
import WritingList from '../../components/WritingList.astro';
const posts = await writingFeed();
---
<Base title="Writing" description="Essays and notes.">
  <header class="page-head">
    <h1>Writing.</h1>
  </header>
  <section class="block">
    <WritingList posts={posts} />
  </section>
</Base>
