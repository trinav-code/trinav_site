---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const when = p.data.draft ? 'Draft' : p.data.date?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={p.data.title} description={p.data.summary}>
  <header class="page-head">
    <h1>{p.data.title}</h1>
    {p.data.summary && <p>{p.data.summary}</p>}
  </header>
  <div class="meta"><span>{when}</span></div>
  <article class="prose"><Content /></article>
</Base>
