---
import { copy } from '../../copy';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import Entries from '../components/Entries.astro';
import ProjectList from '../components/ProjectList.astro';
import { writingFeed } from '../lib/feed';
import WritingList from '../components/WritingList.astro';
import Shelf from '../components/Shelf.astro';
import Cover from '../components/Cover.astro';
import { finishedLabel } from '../lib/format';

const rolesEntry = await getEntry('history', 'roles');
const eduEntry = await getEntry('history', 'education');
const roles = (rolesEntry?.data.items ?? []).filter((r): r is Extract<typeof r, { title: string }> => 'title' in r);
const education = (eduEntry?.data.items ?? []).filter((e): e is Extract<typeof e, { degree: string }> => 'degree' in e);

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = allProjects.filter((p) => p.data.featured).sort((a, b) => a.data.featured! - b.data.featured!);

const posts = await writingFeed();

const current = (await getEntry('books', 'current'))?.data.items ?? [];
const recent = ((await getEntry('books', 'recent'))?.data.items ?? []).slice(0, 10);
---
<Base>
  <header class="hero">
    <div class="hero-text">
      <h1 class="masthead-name">{copy.home.name}</h1>
      <p class="masthead-role">{copy.home.role}</p>
      {copy.home.hero.map((line, i) => <p class={i === 0 ? 'lede' : 'quiet'}>{line}</p>)}
    </div>
  </header>

  <section class="block">
    <BlockHead title={copy.home.work.heading} href="/about#work" link={copy.home.work.link} />
    <Entries items={roles.slice(0, 2).map((r) => ({
      title: r.title, where: r.org, note: r.note, start: r.start, end: r.end, current: r.current,
    }))} />
  </section>

  <section class="block">
    <BlockHead title={copy.home.education.heading} href="/about" link={copy.home.education.link} />
    <Entries items={education.map((e) => ({
      title: e.degree, where: e.detail ? `${e.school}. ${e.detail}.` : e.school, start: e.start, end: e.end,
    }))} />
  </section>

  <section class="block">
    <BlockHead title={copy.home.projects.heading} href="/work" link={copy.home.projects.link} />
    <ProjectList projects={featured} />
  </section>

  <section class="block">
    <BlockHead title={copy.home.writing.heading} href="/writing" link={copy.home.writing.link} />
    <WritingList posts={posts.slice(0, 3)} />
  </section>

  <section class="block">
    <BlockHead title={copy.home.currently.heading} />
    <div class="now">
      <div class="now-reading">
        <h4>{copy.home.currently.reading}</h4>
        <Shelf books={[...current, ...recent]} currentCount={current.length} scale={1} />
        <p class="aside">{copy.home.currently.readingAside}</p>
      </div>
      <div class="now-listening">
        <h4>{copy.home.currently.listening}</h4>
        <div class="now-row listening" id="now-playing" hidden>
          <span class="cover cover-blank" aria-hidden="true" style="width:34px;height:34px"></span>
          <div><p class="np-title"></p><span class="np-meta"></span></div>
        </div>
        <p class="aside">{copy.home.currently.listeningAside}</p>
        <script is:inline>
          /* Spotify, via /api/now-playing. Renders nothing at all on failure. */
          (function () {
            var el = document.getElementById('now-playing');
            if (!el) return;
            fetch('/api/now-playing', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (t) {
              if (!t || t.state === 'none' || !t.title) return;
              var img = el.querySelector('.cover');
              if (t.art) {
                var i = document.createElement('img');
                i.className = 'cover'; i.width = 34; i.height = 34; i.alt = ''; i.src = t.art;
                i.style.cssText = 'width:34px;height:34px';
                img.replaceWith(i);
              }
              el.querySelector('.np-title').textContent = t.title;
              el.querySelector('.np-meta').textContent = t.artist + (t.state === 'playing' ? ' · now' : ' · last played');
              if (t.url) { var a = document.createElement('a'); a.href = t.url; a.rel = 'external noopener'; a.className = 'np-link'; el.parentNode.insertBefore(a, el); a.appendChild(el); }
              el.hidden = false;
            }).catch(function () {});
          })();
        </script>
      </div>
    </div>

    <div class="globe-line">
      <div class="globe-dot" aria-hidden="true"></div>
      <p>{copy.home.currently.globe} <a href="/globe">{copy.home.currently.globeLink}</a></p>
    </div>
  </section>
</Base>
