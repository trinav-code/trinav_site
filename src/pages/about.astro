---
import { copy } from '../../copy';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlockHead from '../components/BlockHead.astro';
import Entries from '../components/Entries.astro';

const roles = ((await getEntry('history', 'roles'))?.data.items ?? []).filter((r): r is Extract<typeof r, { title: string }> => 'title' in r);
const education = ((await getEntry('history', 'education'))?.data.items ?? []).filter((e): e is Extract<typeof e, { degree: string }> => 'degree' in e);
---
<Base title={copy.about.title} description={copy.about.description}>
  <header class="page-head">
    <h1>{copy.about.heading}</h1>
    <p>{copy.about.intro}</p>
  </header>

  <section class="block wide" id="work">
    <BlockHead title={copy.about.work} />
    <Entries items={roles.map((r) => ({
      title: r.title, where: r.org, note: r.note, start: r.start, end: r.end, current: r.current,
    }))} />
  </section>

  <section class="block wide" id="education">
    <BlockHead title={copy.about.education} />
    <Entries items={education.map((e) => ({
      title: e.degree, where: e.detail ? `${e.school}. ${e.detail}.` : e.school, groupNote: e.groupNote, start: e.start, end: e.end,
    }))} />
  </section>
</Base>
