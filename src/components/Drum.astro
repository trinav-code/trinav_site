---
/* A vibrating circular membrane. Modes (m,n) of the ideal drumhead, drawn as
   displaced chords in monochrome line work. Modes cycle slowly on their own;
   a click strikes the membrane at the cursor and excites every mode by how
   much it moves at that point, each decaying at its own inharmonic frequency.
   The only JS island on the home page. */
interface Props { size?: number; label: string }
const { size = 200, label } = Astro.props;
---
<canvas id="drum" class="drum" width={size * 2} height={size * 2} style={`width:${size}px;height:${size}px`} aria-label={label} role="img"></canvas>
<script>
  const cv = document.getElementById('drum') as HTMLCanvasElement | null;
  if (cv) run(cv);

  function run(cv: HTMLCanvasElement) {
    const ctx = cv.getContext('2d')!;
    const W = cv.width, H = cv.height;
    const R = W * 0.44, CX = W / 2, CY = H / 2;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Bessel J_m by series; fine for x < ~20. */
    function besselJ(m: number, x: number): number {
      let term = 1;
      for (let i = 1; i <= m; i++) term *= (x / 2) / i;
      let sum = term;
      const q = -(x * x) / 4;
      for (let k = 1; k < 40; k++) {
        term *= q / (k * (k + m));
        sum += term;
        if (Math.abs(term) < 1e-12) break;
      }
      return sum;
    }

    /* Zeros of J_m: the (m,n) modes and their relative frequencies. */
    const ZEROS: Record<number, number[]> = {
      0: [2.4048, 5.5201, 8.6537],
      1: [3.8317, 7.0156, 10.1735],
      2: [5.1356, 8.4172, 11.6198],
      3: [6.3802, 9.7610, 13.0152],
    };
    const MODES: { m: number; n: number; k: number }[] = [];
    for (const m of [0, 1, 2, 3]) ZEROS[m].forEach((k, i) => MODES.push({ m, n: i + 1, k }));
    const F0 = ZEROS[0][0];

    /* Sample the disc on chords: LINES chords, PTS points each. Precompute
       every mode's shape at every sample so a frame is a weighted sum. */
    const LINES = 34, PTS = 90;
    const samples: { x: number; y: number; r: number; th: number }[][] = [];
    for (let j = 0; j < LINES; j++) {
      const y = -R + (2 * R * (j + 0.5)) / LINES;
      const half = Math.sqrt(Math.max(0, R * R - y * y));
      const row: typeof samples[number] = [];
      for (let i = 0; i < PTS; i++) {
        const x = -half + (2 * half * i) / (PTS - 1);
        row.push({ x, y, r: Math.hypot(x, y) / R, th: Math.atan2(y, x) });
      }
      samples.push(row);
    }
    const shapes = MODES.map(({ m, k }) =>
      samples.map((row) => row.map((s) => besselJ(m, k * s.r) * Math.cos(m * s.th))),
    );

    /* State: an ambient mode that cycles, plus struck-mode amplitudes. */
    let ambient = 0;
    const struck = new Float64Array(MODES.length);
    const phase = new Float64Array(MODES.length);
    let t0 = performance.now();
    let last = t0;

    const AMP = R * 0.24;

    function draw(now: number) {
      const t = (now - t0) / 1000;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      ctx.clearRect(0, 0, W, H);

      /* Ambient: crossfade between neighbouring modes every ~6s. */
      const cycle = reduced ? 0 : (t / 6) % MODES.length;
      const a = Math.floor(cycle), b = (a + 1) % MODES.length;
      const mix = cycle - a;
      const ease = mix * mix * (3 - 2 * mix);
      const wA = (1 - ease) * Math.cos(t * 1.6 * (MODES[a].k / F0) * 0.35);
      const wB = ease * Math.cos(t * 1.6 * (MODES[b].k / F0) * 0.35);
      ambient = reduced ? 0.7 : 0.55;

      /* Struck modes decay; higher modes decay faster, as on a real head. */
      for (let i = 0; i < MODES.length; i++) {
        if (struck[i] < 1e-3) { struck[i] = 0; continue; }
        struck[i] *= Math.exp(-dt * (1.1 + 0.35 * MODES[i].k));
        phase[i] += dt * 2 * Math.PI * (1.4 * MODES[i].k / F0);
      }

      ctx.lineWidth = 1.4;
      ctx.strokeStyle = 'rgba(0,0,0,0.62)';
      ctx.lineJoin = 'round';

      for (let j = 0; j < LINES; j++) {
        ctx.beginPath();
        for (let i = 0; i < PTS; i++) {
          let z = ambient * (wA * shapes[a][j][i] + wB * shapes[b][j][i]);
          for (let q = 0; q < MODES.length; q++) {
            if (struck[q] > 0) z += struck[q] * Math.cos(phase[q]) * shapes[q][j][i];
          }
          const s = samples[j][i];
          const x = CX + s.x, y = CY + s.y - z * AMP;
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      /* Rim. */
      ctx.beginPath();
      ctx.arc(CX, CY, R, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(0,0,0,0.28)';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      if (!reduced || struck.some((v) => v > 0)) requestAnimationFrame(draw);
    }

    /* A strike at (r, th) excites each mode by its own displacement there. */
    function strike(clientX: number, clientY: number) {
      const rect = cv.getBoundingClientRect();
      const px = ((clientX - rect.left) / rect.width) * W - CX;
      const py = ((clientY - rect.top) / rect.height) * H - CY;
      const r = Math.min(0.98, Math.hypot(px, py) / R);
      const th = Math.atan2(py, px);
      for (let i = 0; i < MODES.length; i++) {
        const { m, k } = MODES[i];
        const w = besselJ(m, k * r) * Math.cos(m * th);
        struck[i] = Math.min(1.6, Math.abs(struck[i]) + w * 1.3);
        phase[i] = w < 0 ? Math.PI : 0;
      }
      if (reduced) requestAnimationFrame(draw);
    }

    cv.addEventListener('pointerdown', (e) => { strike(e.clientX, e.clientY); });
    cv.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const rect = cv.getBoundingClientRect();
        strike(rect.left + rect.width * 0.62, rect.top + rect.height * 0.5);
      }
    });
    cv.tabIndex = 0;
    requestAnimationFrame(draw);
  }
</script>
