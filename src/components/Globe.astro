---
/* COBE globe (shuding/cobe). Markers for places, arcs between the places
   lived in order. Monochrome to match the page: ink on paper, one domain
   colour for the markers. Drag to rotate; idles slowly otherwise.
   Respects prefers-reduced-motion by not auto-rotating. */
interface Place { name: string; lat: number; lng: number; label?: string }
interface Props { lived: Place[]; visited: Place[]; size?: number; full?: boolean }
const { lived, visited, size = 600, full = false } = Astro.props;
const markers = [
  ...lived.map((p) => ({ location: [p.lat, p.lng], size: 0.06, kind: 'lived', name: p.label ?? p.name })),
  ...visited.map((p) => ({ location: [p.lat, p.lng], size: 0.035, kind: 'visited', name: p.label ?? p.name })),
];
const arcs = lived.slice(1).map((p, i) => ({ from: [lived[i].lat, lived[i].lng], to: [p.lat, p.lng] }));
const start = lived.at(-1) ?? visited[0];
---
<div class={`globe-wrap ${full ? 'globe-full' : ''}`} style={`--size:${size}px`}>
  <canvas id="globe" width={size * 2} height={size * 2} data-markers={JSON.stringify(markers)} data-arcs={JSON.stringify(arcs)} data-start={JSON.stringify(start ? [start.lat, start.lng] : null)} aria-label="A globe marking the places I have lived and visited" role="img"></canvas>
</div>

<script>
  import createGlobe from 'cobe';

  const cv = document.getElementById('globe') as HTMLCanvasElement | null;
  if (cv) run(cv);

  function run(cv: HTMLCanvasElement) {
    const markers = JSON.parse(cv.dataset.markers ?? '[]');
    const arcs = JSON.parse(cv.dataset.arcs ?? '[]');
    const start = JSON.parse(cv.dataset.start ?? 'null') as [number, number] | null;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Start facing the most recent home. phi is longitude-ish, theta latitude-ish. */
    let phi = start ? ((-start[1] + 90) * Math.PI) / 180 : 0;
    let theta = start ? (start[0] * Math.PI) / 180 * 0.6 : 0.2;
    let dragX: number | null = null, dragPhi = phi, velocity = 0;

    const hex = (h: string): [number, number, number] =>
      [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255) as [number, number, number];
    const INK = hex('#565049'), PAPER = hex('#FBFAF7'), MARK = hex('#3B5486'), LIVED = hex('#2F6B5E');

    const globe = createGlobe(cv, {
      devicePixelRatio: 2,
      width: cv.width, height: cv.height,
      phi, theta,
      dark: 0, diffuse: 2.2,
      scale: 1, offset: [0, 0],
      mapSamples: 20000, mapBrightness: 2.2,
      baseColor: [0.42, 0.40, 0.37],
      markerColor: MARK,
      glowColor: PAPER,
      markers: markers.map((m: any) => ({ location: m.location, size: m.size, color: m.kind === 'lived' ? LIVED : MARK })),
      arcs,
      arcColor: INK, arcWidth: 0.4, arcHeight: 0.22, markerElevation: 0.015,
      onRender: (state) => {
        if (dragX === null) {
          if (!reduced) phi += 0.0025 + velocity;
          velocity *= 0.94;
        }
        state.phi = phi; state.theta = theta;
      },
    });

    cv.style.cursor = 'grab';
    cv.addEventListener('pointerdown', (e) => { dragX = e.clientX; dragPhi = phi; cv.style.cursor = 'grabbing'; cv.setPointerCapture(e.pointerId); });
    cv.addEventListener('pointermove', (e) => {
      if (dragX === null) return;
      const d = (e.clientX - dragX) / 180;
      velocity = (dragPhi + d - phi) * 0.5;
      phi = dragPhi + d;
    });
    const up = () => { dragX = null; cv.style.cursor = 'grab'; };
    cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);
    window.addEventListener('pagehide', () => globe.destroy(), { once: true });
  }
</script>
