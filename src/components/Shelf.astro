---
/* The bookshelf, edge-on. Each spine is a real button whose width is the
   page count, height the format band, and base tint the colour sampled from
   the real cover at build. Lean is chosen by index so it never changes
   between visits. Click pulls the spine out and opens a native popover. */
import type { CollectionEntry } from 'astro:content';
import { when } from '../lib/format';
import { copy } from '../../copy';
import { spineColor, spineText } from '../lib/color';

type Book = CollectionEntry<'books'>['data']['items'][number];
interface Props { books: Book[]; currentCount: number; scale?: number }
const { books, currentCount, scale = 1 } = Astro.props;

/* One shelf height. Format changes the object, not the height:
   physical = full spine, ebook = same height but thin, audiobook = a
   narrow marker rather than a spine. */
const SHELF_H = 146;
const HEIGHT = { physical: SHELF_H, ebook: SHELF_H, audiobook: SHELF_H } as const;
const thickness = (pages?: number) => Math.round(Math.min(22, Math.max(16, (pages ?? 240) / 20)) * scale);
const widthOf = (b: Book) =>
  b.format === 'audiobook' ? Math.round(8 * scale)
  : b.format === 'ebook' ? Math.max(Math.round(9 * scale), Math.round(thickness(b.pages) * 0.5))
  : thickness(b.pages);
/* Exactly one book leans, chosen by index so it is stable across reloads. */
const leaner = books.length > 3 ? Math.min(books.length - 2, Math.max(2, Math.floor(books.length / 3))) : -1;
const FACE_W = 0.66;
const LEAN_DEG = 4, FACE_DEG = 3;
const heightOf = (b: Book) => Math.round(HEIGHT[b.format] * scale);
/* A leaning book touches its neighbour at the neighbour's top edge:
   horizontal reach at that height = min(h, hNeighbour) * sin(angle). */
const restGap = (i: number, deg: number, dir: -1 | 1) => {
  const nb = books[i + dir];
  const h = Math.min(heightOf(books[i]), nb ? heightOf(nb) : heightOf(books[i]));
  return Math.max(0, Math.round(h * Math.sin((deg * Math.PI) / 180)) - 1);
};
const c = copy.home.currently;
---
<div class="shelf-wrap">
<ul class="shelf" aria-label={c.shelfLabel}>
  {books.map((b, i) => {
    const w = thickness(b.pages);
    const h = Math.round(HEIGHT[b.format] * scale);
    const lean = i === leaner ? 'lean' : '';
    const face = i === 0 && currentCount > 0;
    const whenText = b.finished ? c.finished(when(b.finished)) : i < currentCount ? c.readingNow : '';
    const bg = spineColor(b.color);
    const fg = spineText(bg).color;
    /* The face-out book tilts right onto the row; the leaning spine tilts
       left, back toward it, so the two rest against each other's side. */
    const gap = face ? restGap(i, FACE_DEG, 1) : lean ? restGap(i, LEAN_DEG, -1) : 0;
    return (
      <li class={`spine-slot ${lean} ${face ? 'face-slot' : ''} fmt-${b.format}`} style={`--w:${face ? Math.round(h * FACE_W) : w}px;--h:${h}px;--spine:${bg};--spine-text:${fg};--gap:${gap}px`}>
        <button type="button" class={face ? 'spine face' : 'spine'} popovertarget={`book-${i}`} aria-label={`${b.title}, ${b.author}`} data-spine={i}>
          {face && b.coverUrl
            ? <img class="face-cover" src={b.coverUrl} alt="" width={Math.round(h * FACE_W)} height={h} />
            : b.format === 'audiobook'
              ? <span class="audio-mark" aria-hidden="true"></span>
              : <span class="spine-title" aria-hidden="true">{b.title}</span>}
        </button>
        <div popover id={`book-${i}`} class={`book-panel ${b.thoughts ? 'has-thoughts' : ''}`} data-panel={i} style={`--tint:${bg}`}>
          <div class="book-panel-inner">
            {b.coverLarge
              ? <img class="book-cover" src={b.coverLarge} alt={c.coverAlt(b.title)} loading="lazy" />
              : <div class="book-cover book-cover-blank" aria-hidden="true"></div>}
            <div class="book-meta">
              <h3>{b.title}</h3>
              <p class="book-author">{b.author}{whenText && ` · ${whenText}`}</p>
              {b.thoughts && <p class="book-thoughts">{b.thoughts}</p>}
              <button type="button" class="book-close" popovertarget={`book-${i}`} popovertargetaction="hide">{c.close}</button>
            </div>
          </div>
        </div>
      </li>
    );
  })}
</ul>
<div class="shelf-board" aria-hidden="true"></div>
</div>

<script>
  /* Pull the spine forward while its panel is open. The panel itself is
     native popover, so opening and closing work without this script. */
  document.querySelectorAll<HTMLElement>('.book-panel').forEach((panel) => {
    const spine = document.querySelector<HTMLElement>(`.spine[data-spine="${panel.dataset.panel}"]`);
    panel.addEventListener('toggle', (e) => {
      spine?.classList.toggle('pulled', (e as ToggleEvent).newState === 'open');
    });
  });
</script>
