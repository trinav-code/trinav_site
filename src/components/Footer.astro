---
import { copy } from '../../copy';
import { site } from '../../site.config';
const { address, obfuscate } = site.email;
const [user, host] = address.split('@');
---
<footer>
  <ul>
    <li>
      {obfuscate
        ? <button type="button" data-u={user} data-h={host}>{copy.footer.email}</button>
        : <a href={`mailto:${address}`}>{copy.footer.email}</a>}
    </li>
    <li><a href={site.links.github} rel="me">{copy.footer.github}</a></li>
    <li><a href={site.links.linkedin} rel="me">{copy.footer.linkedin}</a></li>
    <li><a href={site.links.medium} rel="me">{copy.footer.medium}</a></li>
    <li><a href="/colophon">{copy.footer.colophon}</a></li>
  </ul>
</footer>
{obfuscate && (
  <script is:inline>
    /* Email lives behind one click so it is not in the markup as plain text. */
    document.querySelector('footer button[data-u]')?.addEventListener('click', function () {
      var a = this.dataset.u + '@' + this.dataset.h;
      window.location.href = 'mailto:' + a;
    });
  </script>
)}
