---
import type { FeedItem } from '../lib/feed';
interface Props { posts: FeedItem[] }
const { posts } = Astro.props;
const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Draft';
---
<ul class="writing">
  {posts.map((p) => (
    <li>
      <a href={p.href} rel={p.external ? 'external noopener' : undefined}>
        <span class="w-title">
          {p.title}
          {p.external && <span class="w-ext" aria-label="on Medium" title="On Medium">↗</span>}
        </span>
        <span class="w-when">{p.draft ? 'Draft' : fmt(p.date)}</span>
      </a>
    </li>
  ))}
</ul>
